# Runtime / generated (keep folder structure via .gitkeep where needed)
logs/*.log
logs/*.log.*
reports/*.json
!reports/.gitkeep

# Large generation outputs — keep metadata dirs, ignore heavy binaries by default
generations/**/*.png
generations/**/*.jpg
generations/**/*.jpeg
generations/**/*.webp
approved/**/*.png
approved/**/*.jpg
pages/**/*.png
kdp/final/*.pdf
kdp/interior/*.pdf
kdp/previews/*.png
kdp/previews/*.pdf

# Colab exchange payloads
colab/outbound/
colab/inbound/

# Local state that may contain paths
config/state.json
